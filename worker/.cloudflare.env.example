# Optional non-interactive auth for the project-local Wrangler profile.
#
# Copy to .cloudflare.env (git-ignored) and fill in to skip `wrangler login`.
# Create the token at: Cloudflare dashboard -> My Profile -> API Tokens
#   Permissions needed for this worker:
#     Account : Workers Scripts        : Edit
#     Account : Workers KV Storage     : Edit
#   Scope it to the bkaproductions account only.
#
# If this file is absent, the wrapper falls back to OAuth (`npm run cf:login`),
# which stores its tokens in worker/.wrangler-profile/ rather than globally.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
