{
  "name": "dubmate-room-registry",
  "version": "1.0.0",
  "description": "Cloudflare Worker room code registry for DubMate Multiplayer Studio",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "node --experimental-strip-types tests/worker.test.mjs",
    "test:integration": "vitest run --config vitest.config.ts",
