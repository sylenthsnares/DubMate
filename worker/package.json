{
  "name": "dubmate-room-registry",
  "version": "1.0.0",
  "description": "Cloudflare Worker room code registry for DubMate Multiplayer Studio",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "node scripts/wrangler.mjs deploy",
    "types": "node scripts/wrangler.mjs types",
    "test": "node --experimental-strip-types tests/worker.test.mjs",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:all": "node --experimental-strip-types tests/worker.test.mjs && vitest run --config vitest.config.ts",
    "cf": "node scripts/wrangler.mjs",
    "cf:login": "node scripts/wrangler.mjs login",
    "cf:logout": "node scripts/wrangler.mjs logout",
    "cf:whoami": "node scripts/wrangler.mjs whoami",
    "cf:deploy": "node scripts/wrangler.mjs deploy",
    "cf:secret": "node scripts/wrangler.mjs secret put DUBMATE_SECRET_KEY",
    "cf:secret:list": "node scripts/wrangler.mjs secret list"
  },
  "keywords": [
    "dubmate",
    "cloudflare-worker",
    "tunnel-registry"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
