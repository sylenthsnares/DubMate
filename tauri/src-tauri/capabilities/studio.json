{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio",
  "description": "Lets the studio page, served by the engine on this computer, show and remove Pack Builder in its settings.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-get-engine-port",
    "allow-get-packbuilder-status",
    "allow-remove-packbuilder"
  ]
}
