{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for DubMate Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-engine-port",
    "allow-get-last-failure",
    "allow-get-file-move",
    "allow-trigger-start-sidecars",
    "allow-apply-update",
    "allow-cancel-update",
    "allow-get-packbuilder-status",
    "allow-start-packbuilder-install",
    "allow-get-packbuilder-install",
    "allow-open-mic-settings",
    "allow-open-studio-in-browser",
    "allow-open-download-page"
  ]
}
