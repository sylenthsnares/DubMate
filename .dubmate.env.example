# Shared key sent to the public room registry as the X-DubMate-Key header.
#
# Copy to .dubmate.env (git-ignored) when running the web version from a source
# checkout. Desktop builds get this baked in at compile time from the
# DUBMATE_SECRET_KEY GitHub secret instead, so you do not need this file for them.
#
# Must match DUBMATE_SECRET_KEY on the Cloudflare Worker:
#   cd worker && npm run cf:secret
#
# Leaving this unset is safe: local and LAN play are unaffected, only public room
# code registration is skipped.

DUBMATE_WORKER_KEY=
