{
  "about": "Shared by tests/test_vocal_chain.py and the studio's resolveChain tests (tests/test_voice_preview.js). A chain written as a string is that preset's chain; \"presets\" spells them out and must equal vocal_chain.PRESETS. Most specific wins: take chain -> voice.characters[character] -> voice.session -> clean; each level replaces the whole chain.",
  "presets": {
    "clean": {"v": 1, "preset": "clean", "nodes": {"lowcut": {"on": true, "mix": 1.0, "hz": 80.0}, "gate": {"on": false, "mix": 1.0, "threshold_db": -50.0}, "eq": {"on": false, "mix": 1.0, "low_db": 0.0, "mid_db": 0.0, "mid_hz": 1500.0, "high_db": 0.0}, "deess": {"on": false, "mix": 1.0, "threshold_db": -30.0, "hz": 6000.0}, "comp": {"on": false, "mix": 1.0, "threshold_db": -18.0, "ratio": 3.0, "makeup_db": 0.0}, "pitch": {"on": false, "mix": 1.0, "semitones": 0}, "reverb": {"on": false, "mix": 0.3, "decay_s": 1.5, "predelay_ms": 20.0}}},
    "warm": {"v": 1, "preset": "warm", "nodes": {"lowcut": {"on": true, "mix": 1.0, "hz": 90.0}, "gate": {"on": false, "mix": 1.0, "threshold_db": -50.0}, "eq": {"on": true, "mix": 1.0, "low_db": 2.0, "mid_db": -1.0, "mid_hz": 400.0, "high_db": -1.5}, "deess": {"on": true, "mix": 1.0, "threshold_db": -28.0, "hz": 6000.0}, "comp": {"on": true, "mix": 1.0, "threshold_db": -20.0, "ratio": 2.5, "makeup_db": 3.0}, "pitch": {"on": false, "mix": 1.0, "semitones": 0}, "reverb": {"on": true, "mix": 0.12, "decay_s": 1.0, "predelay_ms": 15.0}}},
    "radio": {"v": 1, "preset": "radio", "nodes": {"lowcut": {"on": true, "mix": 1.0, "hz": 300.0}, "gate": {"on": false, "mix": 1.0, "threshold_db": -50.0}, "eq": {"on": true, "mix": 1.0, "low_db": -6.0, "mid_db": 5.0, "mid_hz": 1800.0, "high_db": -10.0}, "deess": {"on": false, "mix": 1.0, "threshold_db": -30.0, "hz": 6000.0}, "comp": {"on": true, "mix": 1.0, "threshold_db": -24.0, "ratio": 4.0, "makeup_db": 6.0}, "pitch": {"on": false, "mix": 1.0, "semitones": 0}, "reverb": {"on": false, "mix": 0.3, "decay_s": 1.5, "predelay_ms": 20.0}}},
    "monster": {"v": 1, "preset": "monster", "nodes": {"lowcut": {"on": true, "mix": 1.0, "hz": 60.0}, "gate": {"on": false, "mix": 1.0, "threshold_db": -50.0}, "eq": {"on": true, "mix": 1.0, "low_db": 3.0, "mid_db": 0.0, "mid_hz": 1500.0, "high_db": -2.0}, "deess": {"on": false, "mix": 1.0, "threshold_db": -30.0, "hz": 6000.0}, "comp": {"on": true, "mix": 1.0, "threshold_db": -20.0, "ratio": 3.0, "makeup_db": 3.0}, "pitch": {"on": true, "mix": 1.0, "semitones": -5}, "reverb": {"on": true, "mix": 0.25, "decay_s": 1.8, "predelay_ms": 25.0}}}
  },
  "cases": [
    {"name": "nothing set falls back to Clean",
     "voice": {"session": null, "characters": {}}, "character": "Ana", "take": {"take_id": "a1"},
     "expect": "clean"},
    {"name": "no voice and no take",
     "voice": null, "character": null, "take": null,
     "expect": "clean"},
    {"name": "every-line sound applies to a take without its own",
     "voice": {"session": "radio", "characters": {}}, "character": "Ana", "take": {"take_id": "a1"},
     "expect": "radio"},
    {"name": "session Radio, then Ogre picks Monster: an Ogre take follows Monster",
     "voice": {"session": "radio", "characters": {"Ogre": "monster"}}, "character": "Ogre", "take": {"take_id": "o1"},
     "expect": "monster"},
    {"name": "session Radio, then Ogre picks Monster: another character's take stays Radio",
     "voice": {"session": "radio", "characters": {"Ogre": "monster"}}, "character": "Ana", "take": {"take_id": "a1"},
     "expect": "radio"},
    {"name": "a character sound without an every-line sound; other characters get Clean",
     "voice": {"session": null, "characters": {"Ogre": "warm"}}, "character": "Ana", "take": {"take_id": "a1"},
     "expect": "clean"},
    {"name": "the take's own chain wins over character and session",
     "voice": {"session": "radio", "characters": {"Ogre": "monster"}}, "character": "Ogre",
     "take": {"take_id": "o2", "chain": {"v": 1, "preset": null, "nodes": {"pitch": {"on": true, "mix": 1.0, "semitones": 3}}}},
     "expect": {"v": 1, "preset": null, "nodes": {"pitch": {"on": true, "mix": 1.0, "semitones": 3}}}},
    {"name": "Clean chosen on a take is stored on the take and beats the character's sound",
     "voice": {"session": null, "characters": {"Ogre": "monster"}}, "character": "Ogre",
     "take": {"take_id": "o3", "chain": "clean"},
     "expect": "clean"},
    {"name": "a take chain of null follows the room",
     "voice": {"session": "warm", "characters": {}}, "character": "Ana", "take": {"take_id": "a2", "chain": null},
     "expect": "warm"}
  ]
}
